class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        int lastSeen[256];
        fill(lastSeen, lastSeen + 256, -1);

        int left = 0;
        int maxLength = 0;

        for (int right = 0; right < s.size(); right++) {
            unsigned char c = s[right];

            if (lastSeen[c] >= left) {
                left = lastSeen[c] + 1;
            }

            lastSeen[c] = right;

            maxLength = max(maxLength, right - left + 1);
        }

        return maxLength;
    }
};
